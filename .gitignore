# Terraform state and local metadata - contains resource details/ARNs, never commit
# (.terraform.lock.hcl IS committed - it only pins provider versions, no secrets)
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/crash.log
terraform/crash.*.log
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# Variable files with real (possibly sensitive/environment-specific) values
terraform/*.tfvars
terraform/*.tfvars.json
!terraform/terraform.tfvars.example

# terraform plan output files
terraform/*.tfplan

# SSH keys - never commit, even accidentally placed in-repo
*.pem
*.ppk
id_rsa*
id_ed25519*
*_rsa
*_ed25519
aws-network-lab.pub
aws-network-lab

# Credentials / secrets
.env
.env.*
*credentials*
*.key

# AWS CLI output that may contain account IDs / ARNs, kept local only
scripts/.raw-cli-output/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
